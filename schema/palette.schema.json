{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "cycle": {
      "minItems": 4,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}$"
      }
    },
    "pinned": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "color",
          "rationale"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "cycle",
    "pinned"
  ],
  "additionalProperties": false
}
