                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "calendar_note": {
                "type": "string"
              }
            },
            "required": [
              "year",
              "precision"
            ],
            "additionalProperties": false
          },
          "end": {
            "type": "object",
            "properties": {
              "year": {
                "type": "integer",
                "minimum": -9007199254740991,
