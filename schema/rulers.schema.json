                  "ar": {
                    "type": "string",
                    "enum": [
                      "original",
                      "machine-draft",
                      "reviewed"
                    ]
                  },
                  "he": {
                    "type": "string",
                    "enum": [
                      "original",
                      "machine-draft",
                      "reviewed"
                    ]
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
