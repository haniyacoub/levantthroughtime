                "type": "string",
                "minLength": 1
              },
              "ar": {
                "type": "string",
                "minLength": 1
              },
              "he": {
                "type": "string",
                "minLength": 1
              },
              "translation_status": {
                "type": "object",
                "properties": {
                  "ar": {
                    "type": "string",
                    "enum": [
                      "original",
                      "machine-draft",
                      "reviewed"
                    ]
                  },
                  "he": {
                    "type": "string",
                    "enum": [
                      "original",
                      "machine-draft",
                      "reviewed"
                    ]
                  }
                },
                "additionalProperties": false
