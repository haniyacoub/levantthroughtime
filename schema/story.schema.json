{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "ar": {
          "type": "string",
          "minLength": 1
        },
        "he": {
          "type": "string",
          "minLength": 1
        },
        "translation_status": {
          "type": "object",
          "properties": {
            "ar": {
              "type": "string",
              "enum": [
                "original",
                "machine-draft",
                "reviewed"
              ]
            },
            "he": {
              "type": "string",
              "enum": [
                "original",
                "machine-draft",
                "reviewed"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "en"
      ],
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "ar": {
          "type": "string",
          "minLength": 1
        },
        "he": {
          "type": "string",
          "minLength": 1
        },
        "translation_status": {
          "type": "object",
          "properties": {
            "ar": {
              "type": "string",
              "enum": [
                "original",
                "machine-draft",
                "reviewed"
              ]
            },
            "he": {
              "type": "string",
              "enum": [
                "original",
                "machine-draft",
                "reviewed"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "en"
      ],
      "additionalProperties": false
    },
    "steps": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "object",
            "properties": {
              "year": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "month": {
                "type": "integer",
                "minimum": 1,
                "maximum": 12
              }
            },
            "required": [
              "year"
            ],
            "additionalProperties": false
          },
          "view": {
            "type": "object",
            "properties": {
              "center": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              },
              "zoom": {
                "type": "number"
              }
            },
            "required": [
              "center",
              "zoom"
            ],
            "additionalProperties": false
          },
          "layers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "highlight": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            }
          },
          "title": {
            "type": "object",
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1
              },
              "ar": {
                "type": "string",
                "minLength": 1
              },
              "he": {
                "type": "string",
                "minLength": 1
              },
              "translation_status": {
                "type": "object",
                "properties": {
                  "ar": {
                    "type": "string",
                    "enum": [
                      "original",
                      "machine-draft",
                      "reviewed"
                    ]
                  },
                  "he": {
                    "type": "string",
                    "enum": [
                      "original",
                      "machine-draft",
                      "reviewed"
                    ]
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "en"
            ],
            "additionalProperties": false
          },
          "card": {
            "type": "object",
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1
              },
              "ar": {
                "type": "string",
                "minLength": 1
              },
              "he": {
                "type": "string",
                "minLength": 1
              },
              "translation_status": {
                "type": "object",
                "properties": {
                  "ar": {
                    "type": "string",
                    "enum": [
                      "original",
                      "machine-draft",
                      "reviewed"
                    ]
                  },
                  "he": {
                    "type": "string",
                    "enum": [
                      "original",
                      "machine-draft",
                      "reviewed"
                    ]
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "en"
            ],
            "additionalProperties": false
          },
          "sources": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ref": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                },
                "locator": {
                  "type": "string"
                },
                "quote": {
                  "type": "string"
                },
                "via": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                },
                "note": {
                  "type": "string"
                }
              },
              "required": [
                "ref"
              ],
              "additionalProperties": false
            }
          },
          "duration_s": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "date",
          "title",
          "card",
          "sources"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "title",
    "summary",
    "steps"
  ],
  "additionalProperties": false
}
