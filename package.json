{
  "name": "southern-levant-through-time",
  "private": true,
  "version": "0.2.0",
  "description": "Interactive history map of the southern Levant, 10,000 BCE to today",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build-data && vite",
    "build": "npm run build-data && tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "validate-data": "tsx scripts/validate-data.ts",
    "build-data": "tsx scripts/build-data.ts",
    "build-basemap": "tsx scripts/build-basemap.ts",
    "gen-schema": "tsx scripts/gen-json-schema.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test tests/e2e/smoke.spec.ts",
    "screenshots": "playwright test tests/e2e/screenshots.spec.ts",
    "review": "tsx scripts/review.ts",
    "build-landscape": "tsx scripts/build-landscape.ts"
  },
  "dependencies": {
    "@deck.gl/core": "9.4.0",
    "@deck.gl/geo-layers": "9.4.0",
    "@deck.gl/layers": "9.4.0",
    "@deck.gl/mapbox": "9.4.0",
    "@fontsource/noto-sans": "5.3.0",
    "@fontsource/noto-sans-arabic": "5.3.0",
    "@fontsource/noto-sans-hebrew": "5.3.0",
    "d3-array": "3.2.4",
    "d3-format": "3.1.2",
    "d3-geo": "3.1.1",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "i18next": "26.4.2",
    "maplibre-gl": "6.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.15",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@turf/turf": "7.4.0",
    "@types/d3-array": "3.2.2",
    "@types/d3-contour": "3.0.6",
    "@types/d3-format": "3.0.4",
    "@types/d3-geo": "3.1.1",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.2.0",
    "@types/geojson": "7946.0.16",
    "@types/node": "25.9.9",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "d3-contour": "4.0.2",
    "jsdom": "30.1.1",
    "playwright-core": "1.63.0",
    "pngjs": "7.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
